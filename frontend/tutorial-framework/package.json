{
  "name": "@localm/tutorial-framework",
  "version": "1.0.0",
  "description": "Shared React component library for LocalM tutorial static websites",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test:playwright:serve": "vite tests/harness --host 127.0.0.1 --port 4173 --strictPort",
    "test:playwright": "playwright test",
    "test:playwright:headed": "playwright test --headed"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "react-syntax-highlighter": "^15.6.1",
    "spectacle": "^10.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.5"
  },
  "keywords": [
    "tutorial",
    "react",
    "components",
    "static",
    "localm",
    "github-pages"
  ],
  "license": "MIT",
  "overrides": {
    "lodash": "4.18.1",
    "brace-expansion": "1.1.13",
    "yaml": "2.8.3",
    "postcss": "8.5.10",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "jest-util": {
      "picomatch": "2.3.2"
    },
    "jest-haste-map": {
      "picomatch": "2.3.2"
    },
    "babel-plugin-styled-components": {
      "picomatch": "2.3.2"
    },
    "tinyglobby": {
      "picomatch": "4.0.4"
    },
    "fdir": {
      "picomatch": "4.0.4"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    }
  }
}